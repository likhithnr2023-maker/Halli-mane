<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Halli mane Tea point | Coffee Shop in Kollegala</title>
<meta name="description" content="Visit Halli mane Tea point in Kollegala, Karnataka for authentic filter coffee, masala chai, and South Indian snacks. Dine-in available.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Work+Sans:wght@400;500;600&family=Caveat:wght@600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --brew: #2B1810;
    --brew-2: #3d2417;
    --paper: #F5EFE0;
    --paper-2: #ECE3CE;
    --clay: #C1592B;
    --clay-dark: #9c4520;
    --turmeric: #D9A441;
    --leaf: #3F5B3D;
    --ink: #2B1810;
    --ink-soft: #5c4a3d;
    --line: rgba(43,24,16,0.14);
    --radius: 3px;
  }

  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background: var(--paper);
    color: var(--ink);
    font-family: 'Work Sans', sans-serif;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  @media (prefers-reduced-motion: reduce){
    *{animation-duration:0.001ms !important; animation-iteration-count:1 !important; scroll-behavior:auto !important;}
  }

  h1,h2,h3{
    font-family:'Fraunces', serif;
    font-weight:600;
    color: var(--brew);
    letter-spacing:-0.01em;
  }

  a{color:inherit;}
  img{max-width:100%; display:block;}
  section{padding: 88px 24px;}
  .wrap{max-width:1080px; margin:0 auto;}

  ::selection{ background: var(--turmeric); color: var(--brew); }

  a:focus-visible, button:focus-visible, input:focus-visible, textarea:focus-visible{
    outline: 2px solid var(--clay);
    outline-offset: 3px;
  }

  /* Eyebrow label */
  .eyebrow{
    font-family:'Caveat', cursive;
    font-size: 1.5rem;
    color: var(--clay);
    display:inline-block;
    margin-bottom: 6px;
    transform: rotate(-1.5deg);
  }

  /* ===== NAV ===== */
  header.site{
    position: sticky; top:0; z-index: 50;
    background: rgba(245,239,224,0.92);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--line);
  }
  .nav{
    max-width:1080px; margin:0 auto; padding: 16px 24px;
    display:flex; align-items:center; justify-content:space-between;
  }
  .brand{
    font-family:'Fraunces', serif; font-weight:700; font-size:1.3rem;
    display:flex; align-items:center; gap:10px; text-decoration:none;
    color: var(--brew);
  }
  .brand .mark{
    width: 30px; height:30px; border-radius:50%;
    background: var(--clay);
    display:grid; place-items:center;
    color:var(--paper); font-size:0.85rem; font-weight:700;
  }
  nav.links{display:flex; gap: 28px; font-size:0.95rem;}
  nav.links a{text-decoration:none; color:var(--ink-soft); position:relative; padding: 4px 0;}
  nav.links a:hover{color: var(--clay);}
  .nav-cta{
    background:var(--clay); color:var(--paper); padding:10px 18px;
    border-radius: var(--radius); text-decoration:none; font-size:0.9rem; font-weight:600;
    white-space:nowrap;
  }
  .nav-cta:hover{background:var(--clay-dark);}
  .menu-toggle{display:none; background:none; border:none; font-size:1.6rem; color:var(--brew); cursor:pointer;}

  @media (max-width: 760px){
    nav.links{
      position:absolute; top:100%; left:0; right:0;
      background:var(--paper); flex-direction:column; gap:0;
      border-bottom: 1px solid var(--line);
      max-height:0; overflow:hidden; transition: max-height 0.3s ease;
    }
    nav.links.open{max-height: 300px;}
    nav.links a{padding: 14px 24px; border-top:1px solid var(--line);}
    .nav-cta{display:none;}
    .menu-toggle{display:block;}
  }

  /* ===== HERO ===== */
  .hero{
    position:relative;
    padding: 0;
    overflow:hidden;
    background: var(--brew);
    color: var(--paper);
  }
  .hero-inner{
    max-width:1080px; margin:0 auto;
    padding: 90px 24px 70px;
    display:grid; grid-template-columns: 1.1fr 0.9fr; gap:48px; align-items:center;
  }
  @media(max-width:860px){ .hero-inner{grid-template-columns:1fr; padding-top:56px;} }

  .hero-tag{
    font-family:'Work Sans'; font-size:0.85rem; letter-spacing:0.14em; text-transform:uppercase;
    color: var(--turmeric); margin-bottom:18px; display:flex; align-items:center; gap:10px;
  }
  .hero-tag::before{content:''; width:26px; height:1px; background:var(--turmeric);}
  .hero h1{
    color: var(--paper);
    font-size: clamp(2.4rem, 5.5vw, 3.6rem);
    line-height:1.06;
    margin-bottom: 20px;
  }
  .hero h1 em{ font-style:italic; color: var(--clay); font-weight:500; }
  .hero p.lede{
    color: #E4D9C4; font-size:1.1rem; max-width:46ch; margin-bottom:34px;
  }
  .hero-actions{display:flex; gap:14px; flex-wrap:wrap;}
  .btn{
    display:inline-flex; align-items:center; gap:8px;
    padding: 13px 24px; border-radius: var(--radius);
    text-decoration:none; font-weight:600; font-size:0.95rem;
    border:1px solid transparent; cursor:pointer;
  }
  .btn-primary{ background: var(--clay); color:var(--paper); }
  .btn-primary:hover{ background: var(--clay-dark); }
  .btn-ghost{ border-color: rgba(245,239,224,0.35); color: var(--paper); background:transparent; }
  .btn-ghost:hover{ border-color: var(--paper); background: rgba(245,239,224,0.08); }

  /* Signature: coffee pour animation */
  .pour-scene{
    position:relative; height: 340px;
    display:flex; align-items:flex-end; justify-content:center;
  }
  .pour-scene svg{ width:100%; height:100%; max-width:320px; }
  .steam{
    animation: rise 3.2s ease-in-out infinite;
    transform-origin: bottom center;
  }
  .steam.s2{ animation-delay: 0.9s; }
  .steam.s3{ animation-delay: 1.8s; }
  @keyframes rise{
    0%{ opacity:0; transform: translateY(0) scaleX(1); }
    20%{ opacity:0.55; }
    100%{ opacity:0; transform: translateY(-46px) scaleX(1.4); }
  }
  .pour-stream{
    stroke-dasharray: 60;
    stroke-dashoffset: 60;
    animation: pour 2.6s ease-in-out infinite;
  }
  @keyframes pour{
    0%{ stroke-dashoffset:60; opacity:0; }
    8%{ opacity:1; }
    45%{ stroke-dashoffset:0; }
    62%{ stroke-dashoffset:0; opacity:1;}
    75%{ opacity:0; }
    100%{ stroke-dashoffset:60; opacity:0; }
  }
  .tumbler-top{
    animation: tilt 2.6s ease-in-out infinite;
    transform-origin: 70% 85%;
  }
  @keyframes tilt{
    0%,8%{ transform: rotate(0deg); }
    30%,55%{ transform: rotate(-38deg); }
    75%,100%{ transform: rotate(0deg); }
  }

  /* ===== SECTION HEADS ===== */
  .section-head{ max-width: 640px; margin-bottom: 48px; }
  .section-head h2{ font-size: clamp(1.8rem, 3.4vw, 2.4rem); }
  .section-head p{ color: var(--ink-soft); margin-top:10px; font-size:1.05rem; }

  /* ===== MENU ===== */
  .menu-grid{
    display:grid; grid-template-columns: repeat(3, 1fr); gap: 28px;
  }
  @media(max-width:860px){ .menu-grid{grid-template-columns: repeat(2,1fr);} }
  @media(max-width:560px){ .menu-grid{grid-template-columns: 1fr;} }
  .menu-card{
    background: var(--paper-2);
    border-radius: var(--radius);
    overflow:hidden;
    border: 1px solid var(--line);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .menu-card:hover{ transform: translateY(-5px); box-shadow: 0 14px 30px -14px rgba(43,24,16,0.35); }
  .menu-card .thumb{ aspect-ratio: 4/3; overflow:hidden; background:#ddd0b0; }
  .menu-card .thumb img{ width:100%; height:100%; object-fit:cover; }
  .menu-card .body{ padding: 20px; }
  .menu-card h3{ font-size:1.15rem; margin-bottom:8px; }
  .menu-card p{ color:var(--ink-soft); font-size:0.94rem; }

  /* ===== ABOUT ===== */
  .about{ background: var(--brew); color: var(--paper); }
  .about .wrap{ display:grid; grid-template-columns: 1fr 1fr; gap:64px; align-items:start;}
  @media(max-width:860px){ .about .wrap{grid-template-columns:1fr; gap:40px;} }
  .about .eyebrow{ color: var(--turmeric); }
  .about h2{ color: var(--paper); font-size:clamp(1.8rem,3.2vw,2.3rem); margin-bottom:20px;}
  .about p{ color:#DDD0BA; margin-bottom:16px; max-width: 52ch;}
  .rating-block{
    display:flex; align-items:center; gap:16px; margin-top: 28px;
    padding-top:24px; border-top:1px solid rgba(245,239,224,0.18);
  }
  .rating-num{ font-family:'Fraunces',serif; font-size:2.4rem; color:var(--turmeric); }
  .rating-block small{ color:#B8AA92; display:block; }

  .traits{ display:grid; gap:22px; }
  .trait{ display:flex; gap:16px; align-items:flex-start; }
  .trait .num{
    font-family:'Fraunces',serif; font-size:1rem; color: var(--clay);
    border:1px solid rgba(193,89,43,0.5); border-radius:50%;
    width:34px; height:34px; flex-shrink:0; display:grid; place-items:center;
  }
  .trait h3{ color:var(--paper); font-size:1.05rem; margin-bottom:4px; }
  .trait p{ color:#C6B89F; font-size:0.92rem; margin:0; }

  /* ===== GALLERY ===== */
  .gallery-grid{
    display:grid; grid-template-columns: repeat(3,1fr); gap:18px;
  }
  @media(max-width:760px){ .gallery-grid{grid-template-columns:1fr;} }
  .gallery-item{ position:relative; border-radius:var(--radius); overflow:hidden; aspect-ratio: 4/5; background:#ddd0b0;}
  .gallery-item img{ width:100%; height:100%; object-fit:cover; transition: transform 0.5s ease;}
  .gallery-item:hover img{ transform: scale(1.06); }
  .gallery-cap{
    position:absolute; left:0; right:0; bottom:0; padding: 16px;
    background: linear-gradient(to top, rgba(43,24,16,0.85), transparent);
    color: var(--paper); font-family:'Caveat',cursive; font-size:1.3rem;
  }

  /* ===== REVIEWS ===== */
  .reviews-summary{ display:flex; align-items:baseline; gap:14px; margin-bottom:36px; }
  .reviews-summary .big{ font-family:'Fraunces',serif; font-size:2.6rem; color:var(--clay); }
  .stars{ color: var(--turmeric); letter-spacing:2px; }
  .review-grid{ display:grid; grid-template-columns: repeat(3,1fr); gap:24px; margin-bottom:56px; }
  @media(max-width:860px){ .review-grid{grid-template-columns:1fr;} }
  .review-card{
    background:var(--paper-2); border:1px solid var(--line); border-radius:var(--radius);
    padding:24px;
  }
  .review-card .stars{ margin-bottom:12px; display:block; }
  .review-card p{ color:var(--ink-soft); font-size:0.95rem; margin-bottom:16px; }
  .review-who{ font-weight:600; font-size:0.92rem; }
  .review-when{ color:var(--ink-soft); font-size:0.82rem; }

  .review-form{
    background: var(--paper-2); border:1px solid var(--line); border-radius:var(--radius);
    padding: 32px; max-width: 640px;
  }
  .review-form h3{ margin-bottom:18px; font-size:1.2rem;}
  .form-row{ margin-bottom:16px; }
  .form-row label{ display:block; font-size:0.85rem; color:var(--ink-soft); margin-bottom:6px; font-weight:600;}
  .form-row input, .form-row textarea{
    width:100%; padding:11px 13px; border:1px solid var(--line); border-radius:var(--radius);
    font-family:'Work Sans'; font-size:0.95rem; background:var(--paper); color:var(--ink);
  }
  .form-row textarea{ min-height:90px; resize:vertical; }
  .star-picker{ display:flex; gap:6px; font-size:1.5rem; }
  .star-picker button{
    background:none; border:none; cursor:pointer; color: var(--line); padding:0; line-height:1;
  }
  .star-picker button.active, .star-picker button:hover{ color: var(--turmeric); }
  .submit-btn{
    background: var(--clay); color:var(--paper); border:none; padding:13px 26px;
    border-radius: var(--radius); font-weight:600; cursor:pointer; font-size:0.95rem;
  }
  .submit-btn:hover{ background:var(--clay-dark); }
  .form-note{ font-size:0.85rem; color: var(--leaf); margin-top:12px; display:none; }
  .form-note.show{ display:block; }

  /* ===== VISIT ===== */
  .visit{ background: var(--paper-2); }
  .visit .wrap{ display:grid; grid-template-columns: 1fr 1fr; gap: 56px; }
  @media(max-width:860px){ .visit .wrap{grid-template-columns:1fr;} }
  .visit-info h3{ font-size:1rem; text-transform:uppercase; letter-spacing:0.06em; color:var(--clay); margin-bottom:6px;}
  .visit-info .block{ margin-bottom:26px; }
  .visit-info p{ color: var(--ink-soft); }
  .map-frame{
    border-radius: var(--radius); overflow:hidden; border:1px solid var(--line);
    aspect-ratio: 4/3;
  }
  .map-frame iframe{ width:100%; height:100%; border:0; }
  .social-row{ display:flex; gap:14px; margin-top:6px; }
  .social-row a{
    width:38px; height:38px; border-radius:50%; border:1px solid var(--line);
    display:grid; place-items:center; text-decoration:none; color:var(--brew); font-size:0.85rem;
  }
  .social-row a:hover{ background:var(--clay); color:var(--paper); border-color:var(--clay); }

  /* ===== FOOTER ===== */
  footer{
    background: var(--brew); color:#C6B89F; text-align:center;
    padding: 32px 24px; font-size:0.85rem;
  }
</style>
</head>
